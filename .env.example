# FRP Panel 环境配置

# ========== 服务端配置 ==========
# 控制面板端口
FRP_PANEL_PORT=9000

# 数据库路径
FRP_PANEL_DB_PATH=/data/frp-panel.db

# 日志级别 (debug, info, warn, error)
FRP_PANEL_LOG_LEVEL=info

# 运行模式 (control, router)
FRP_PANEL_MODE=control

# ========== 路由器配置 ==========
# 快照目录
FRP_PANEL_ROUTER_SNAPSHOT_DIR=/var/lib/frp-panel/router/snapshots

# 证书目录
FRP_PANEL_ROUTER_CERT_DIR=/var/lib/frp-panel/router/certificates

# ========== FRPS 配置 ==========
# FRPS 绑定端口
FRPS_BIND_PORT=7000

# FRPS 虚拟主机 HTTP 端口
FRPS_VHOST_HTTP_PORT=8080

# FRPS Token (首次启动时自动生成)
# FRPS_TOKEN=

# ========== 安全配置 ==========
# 主密钥文件路径 (首次启动时自动生成)
# FRP_PANEL_MASTER_KEY_FILE=/data/secrets/master.key

# 配置签名密钥路径
# FRP_PANEL_CONFIG_SIGNING_KEY=/data/secrets/config-signing.key

# Router 快照密钥路径
# FRP_PANEL_ROUTER_SNAPSHOT_KEY=/data/secrets/router-snapshot.key

# ========== TLS 配置 ==========
# TLS 证书文件
# FRP_PANEL_TLS_CERT=/etc/frp-panel/server.crt

# TLS 密钥文件
# FRP_PANEL_TLS_KEY=/etc/frp-panel/server.key

# ========== 备份配置 ==========
# 备份目录
# FRP_PANEL_BACKUP_DIR=/data/backups

# 备份保留天数
# FRP_PANEL_BACKUP_RETENTION_DAYS=30

# ========== 客户端配置 ==========
# 客户端端口
FRP_CLIENT_PANEL_PORT=7410

# 客户端数据库路径
FRP_CLIENT_PANEL_DB_PATH=/var/lib/frp-client-panel/client.db

# 客户端日志级别
FRP_CLIENT_PANEL_LOG_LEVEL=info
